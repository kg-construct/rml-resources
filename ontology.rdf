  <rdf:Description rdf:about="http://w3id.org/rml/UniqueAnnotation">
    <rdfs:label>Unique Annotation</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/lv/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/rml/StructuralAnnotation"/>
    <rdfs:comment>A unique annotation is analogous to the notion of UNIQUE constraints in databases. .</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/DatatypeMap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdfs:label>Datatype Map</rdfs:label>
    <rdfs:comment xml:lang="en">Represents a datatype map</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://w3id.org/rml/TermMap"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/IterableField">
    <rdfs:label>Iterable Field</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/lv/"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/rml/Iterable"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/rml/Field"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An iterable field is an iterable that gives a name to a logical iteration.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/ObjectMap">
    <rdfs:label>Object Map</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://w3id.org/rml/TermMap"/>
    <rdfs:comment xml:lang="en">Represents an object map.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
