  <rdf:Description rdf:about="http://w3id.org/rml/graphMap">
    <rdfs:label>graph map</rdfs:label>
    <rdfs:range rdf:resource="http://w3id.org/rml/GraphMap"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
