  <rdf:Description rdf:about="http://w3id.org/rml/class">
    <rdfs:label>class</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:comment xml:lang="en">The subject value generated for a logical source record will be asserted as an instance of this RDFS class.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
