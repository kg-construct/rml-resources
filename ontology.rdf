  <rdf:Description rdf:about="http://w3id.org/rml/io/">
    <ns1:status>draft</ns1:status>
    <dcterms:description xml:lang="en">RML-IO enables the description of input data sources and target output data serialization </dcterms:description>
    <dcterms:created>2023-03-14</dcterms:created>
    <dcterms:contributor>Pano Maria</dcterms:contributor>
    <dcterms:contributor>Dylan Van Assche</dcterms:contributor>
