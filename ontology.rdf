    <vann:preferredNamespaceUri>http://w3id.org/rml/</vann:preferredNamespaceUri>
    <dcterms:description xml:lang="en">RML Logical Views flatten nested data, allow flexible joining of data sources, and handle mix source formats.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:modified>2025-01-14</dcterms:modified>
    <owl:versionInfo>0.1.0</owl:versionInfo>
  </rdf:Description>
