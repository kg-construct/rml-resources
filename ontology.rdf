    <dcterms:contributor>Ben de Meester</dcterms:contributor>
    <dcterms:description xml:lang="en">RML-FNML provides data transformations for generating knowledge graphs from (semi-)structured data</dcterms:description>
    <vann:preferredNamespacePrefix>rml</vann:preferredNamespacePrefix>
    <dcterms:modified>2023-06-15</dcterms:modified>
