    <rdfs:range rdf:resource="http://w3id.org/rml/LogicalViewJoin"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/lv/"/>
    <rdfs:domain rdf:resource="http://w3id.org/rml/LogicalView"/>
    <rdfs:label>left join</rdfs:label>
    <rdfs:comment>A left join of the logical view.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/Strategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/cc/"/>
    <rdfs:label>Strategy</rdfs:label>
    <rdfs:comment xml:lang="en">Denotes a strategy to perform a action (e.g. gather for collections and containers, joins).</rdfs:comment>
