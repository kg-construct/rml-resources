  <rdf:Description rdf:about="http://w3id.org/rml/termType">
    <rdfs:label>term type</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdfs:range rdf:nodeID="n5e485b2de8aa4910a8f1839108bffde6b7"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://w3id.org/rml/TermMap"/>
    <rdfs:comment xml:lang="en">A string indicating whether subject or object generated using the value from a source record name specified should be an IRI/URI (safe or unsafe) reference, blank node, or a literal.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/Target">
    <rdfs:comment xml:lang="en">Denotes a target.</rdfs:comment>
