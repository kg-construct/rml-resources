    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/Field">
    <rdfs:label>Field</rdfs:label>
    <rdfs:comment>A field gives a name to data derived from the abstract logical source on which a logical view is defined.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/lv/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/function">
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/fnml/"/>
    <rdfs:comment xml:lang="en">Specifies a data transformation function.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <rdfs:domain rdf:resource="http://w3id.org/rml/FunctionExecution"/>
    <rdfs:label>function</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/child">
