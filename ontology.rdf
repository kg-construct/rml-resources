  <rdf:Description rdf:about="http://w3id.org/rml/datatypeMap">
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdfs:range rdf:resource="http://w3id.org/rml/DatatypeMap"/>
    <rdfs:domain rdf:resource="http://w3id.org/rml/ObjectMap"/>
    <rdfs:label>datatype map</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">A DatatypetMap element to generate the datatype component of the object component from a logical source record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/XPath">
    <rdfs:comment xml:lang="en">Denotes the XPath reference formulation, used for referring to extracts of XML sources.</rdfs:comment>
