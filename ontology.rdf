    <vann:preferredNamespacePrefix>rml</vann:preferredNamespacePrefix>
    <dcterms:title xml:lang="en">RML: Generic Mapping Language for RDF</dcterms:title>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <dcterms:created>2023-03-14</dcterms:created>
    <owl:versionIRI rdf:resource="http://w3id.org/rml/core/"/>
    <dcterms:modified>2023-06-15</dcterms:modified>
    <dcterms:description xml:lang="en">Generic Mapping Language for RDF (RDB/CSV/TSV/XML/JSON/... to RDF) - Vocabulary description</dcterms:description>
    <dcterms:publisher rdf:resource="https://www.w3.org/community/kg-construct/"/>
    <ns1:status>draft</ns1:status>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/XPathReferenceFormulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>XPath Reference Formulation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://w3id.org/rml/ReferenceFormulation"/>
    <rdfs:comment xml:lang="en">Denotes a XPath Reference Formulation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/io/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/serialization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Defines the serialization to generate the target output.</rdfs:comment>
    <rdfs:domain rdf:resource="http://w3id.org/rml/LogicalTarget"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/io/"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/formats/Format"/>
    <rdfs:label>serialization</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/IRISafeAnnotation">
    <rdfs:label>IRI Safe Annotation</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/lv/"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/rml/StructuralAnnotation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A IRI safe annotation indicates that the field content is IRI safe.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/StarMap">
    <rdfs:comment xml:lang="eb">Represents a star map able to generate RDF-star triples.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Star Map</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/star/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/SubjectMap">
    <rdfs:label>Subject Map</rdfs:label>
    <rdfs:comment xml:lang="en">Represents a subject map.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/rml/TermMap"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/reference">
    <rdfs:label>reference</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>A valid expression that selects values from the source data. The reference should conform to the syntax rules/grammar of the specified Reference Formulation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://w3id.org/rml/ExpressionMap"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/languageMap">
    <rdfs:range rdf:resource="http://w3id.org/rml/LanguageMap"/>
    <rdfs:comment xml:lang="en">A LanguagetMap element to generate the language tag of the object component from a logical source record.</rdfs:comment>
    <rdfs:label>language map</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://w3id.org/rml/ObjectMap"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/gather">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://w3id.org/rml/GatherMap"/>
    <rdfs:label>gather</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/cc/"/>
    <rdfs:comment xml:lang="en">Specifies where the terms of a collection or container come from.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/Literal">
    <rdfs:comment xml:lang="en">Denotes a Literal, used with termType.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Literal</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/returnMap">
    <rdfs:domain rdf:resource="http://w3id.org/rml/ExpressionMap"/>
    <rdfs:comment xml:lang="en">A Return Map element to generate the return output of a function.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://w3id.org/rml/ReturnMap"/>
    <rdfs:label>return map</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/fnml/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/template">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">A template (format string) to specify how to generate a value for a expression map, using one or more records from a logical source record.</rdfs:comment>
    <rdfs:label>template</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdfs:domain rdf:resource="http://w3id.org/rml/ExpressionMap"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/language">
    <rdfs:label>language</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdfs:domain rdf:resource="http://w3id.org/rml/ObjectMap"/>
    <rdfs:comment xml:lang="en">Specified the language for the object component for the generated triple.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/predicate">
    <rdfs:comment xml:lang="en">Specifies the predicate for the generated triple from the logical source record.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdfs:domain rdf:resource="http://w3id.org/rml/PredicateObjectMap"/>
    <rdfs:label>predicate</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/namespacePrefix">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Describes the prefix of a namespace.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/io/"/>
    <rdfs:label>namespace prefix</rdfs:label>
    <rdfs:domain rdf:resource="http://w3id.org/rml/Namespace"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/AbstractLogicalSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/rml/Iterable"/>
    <rdfs:label>Abstract Logical Source</rdfs:label>
    <rdfs:comment xml:lang="en">An iterable that can be associated with a triples map such that a data source can be mapped to RDF triples.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/parent">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://w3id.org/rml/Join"/>
    <rdfs:comment xml:lang="en">Names a source record in the parent source of a join.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>parent</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/objectMap">
    <rdfs:domain rdf:resource="http://w3id.org/rml/PredicateObjectMap"/>
    <rdfs:comment xml:lang="en">An ObjectMap element to generate the object component of the (predicate, object) pair from a logical source record.</rdfs:comment>
    <rdfs:label>object map</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/viewOn">
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/lv/"/>
    <rdfs:label>view on</rdfs:label>
    <rdfs:domain rdf:resource="http://w3id.org/rml/LogicalView"/>
    <rdfs:range rdf:resource="http://w3id.org/rml/AbstractLogicalSource"/>
    <rdfs:comment>The source of the logical view. This is the abstract logical source from which the logical view is derived.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/parameterMap">
    <rdfs:domain rdf:resource="http://w3id.org/rml/Input"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/fnml/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>parameter map</rdfs:label>
    <rdfs:comment xml:lang="en">A Parameter Map element to generate the parameter of a function.</rdfs:comment>
    <rdfs:range rdf:resource="http://w3id.org/rml/ParameterMap"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/functionMap">
    <rdfs:range rdf:resource="http://w3id.org/rml/FunctionMap"/>
    <rdfs:comment xml:lang="en">A Function Map element to generate the data transformation function.</rdfs:comment>
    <rdfs:domain rdf:resource="http://w3id.org/rml/Input"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/fnml/"/>
