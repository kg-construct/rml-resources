  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/iterator">
    <rdfs:domain rdf:resource="http://w3id.org/rml/Iterable"/>
    <rdfs:label>iterator</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdfs:comment xml:lang="en">An expression qualified according to the reference formulation that defines a sequence of logical iterations on the data source.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/LogicalTarget">
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/io/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>LogicalTarget</rdfs:label>
    <rdfs:comment xml:lang="en">Denotes a logical target.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/encoding">
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/io/"/>
    <rdfs:range rdf:resource="http://w3id.org/rml/Encoding"/>
