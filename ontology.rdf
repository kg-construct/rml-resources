    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/UnsafeIRI">
    <rdfs:label>Unsafe IRI</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdfs:comment xml:lang="en">Denotes an unsafe IRI, used with termType.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/ReturnMap">
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/fnml/"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/rml/TermMap"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
