    <rdfs:domain rdf:resource="http://w3id.org/rml/StarMap"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:nodeID="nd80bd11874d1473294960ed9e1e9c65fb1"/>
    <rdfs:comment xml:lang="en">An quoted TriplesMap element to generate a RDF-star triple as subject or object or another triple from a logical source record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/LanguageMap">
    <rdfs:label>Language Map</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdfs:comment>Represents a language map</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://w3id.org/rml/ExpressionMap"/>
  </rdf:Description>
