    <rdfs:seeAlso rdf:resource="http://www.w3.org/TR/xpath20/"/>
    <rdfs:label>XPath</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/lv/">
    <vann:preferredNamespacePrefix>rml</vann:preferredNamespacePrefix>
    <dcterms:license rdf:resource="http://purl.org/NET/rdflicense/cc-by4.0"/>
    <dcterms:title xml:lang="en">RML Logical Views</dcterms:title>
