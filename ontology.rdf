  <rdf:Description rdf:about="http://w3id.org/rml/constant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:domain rdf:resource="http://w3id.org/rml/ExpressionMap"/>
    <rdfs:comment xml:lang="en">A property for indicating whether a expression map is a constant-valued expression map.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdfs:label>constant</rdfs:label>
