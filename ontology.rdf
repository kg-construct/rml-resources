    <dcterms:contributor>Ana Iglesias Molina</dcterms:contributor>
    <dcterms:publisher rdf:resource="https://www.w3.org/community/kg-construct/"/>
    <vann:preferredNamespaceUri>http://w3id.org/rml/</vann:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <owl:imports rdf:resource="http://w3id.org/rml/core/"/>
    <vann:preferredNamespacePrefix>rml</vann:preferredNamespacePrefix>
    <dcterms:license rdf:resource="http://purl.org/NET/rdflicense/cc-by4.0"/>
    <owl:versionIRI rdf:resource="http://w3id.org/rml/io"/>
    <dcterms:title xml:lang="en">RML-IO: Source and Target</dcterms:title>
    <dcterms:modified>2025-01-18</dcterms:modified>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/referenceFormulation">
    <rdfs:label>reference formulation</rdfs:label>
    <rdfs:domain rdf:resource="http://w3id.org/rml/Iterable"/>
    <rdfs:comment xml:lang="en">The reference formulation used to refer to extracts of the source data. </rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://w3id.org/rml/ReferenceFormulation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/BlankNode">
    <rdfs:comment xml:lang="en">Denotes a blank node, used with termType</rdfs:comment>
    <rdfs:label>Blank Node</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/gzip">
    <rdfs:label>GZip</rdfs:label>
    <rdfs:comment xml:lang="en">Represents GZip file compression.</rdfs:comment>
    <rdf:type rdf:resource="http://w3id.org/rml/Compression"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/io/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/LogicalViewJoin">
    <rdfs:comment>A logical view join is an operation that adapts the logical iterations of one logical view (the child logical view) with fields from another logical view (the parent logical view).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Logical View Join</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/lv/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/TriplesMap">
    <rdfs:comment xml:lang="en">Represents a triples map.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Triples Map</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/append">
    <rdfs:comment xml:lang="en">Informs that the sets of RDF terms generated by each TermMap of the GatherMap are to be appended within the collection or container.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/cc/"/>
    <rdfs:label>Append</rdfs:label>
    <rdf:type rdf:resource="http://w3id.org/rml/Strategy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n5e485b2de8aa4910a8f1839108bffde6b7">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n5e485b2de8aa4910a8f1839108bffde6b8"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/GatherMap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Denotes a term map that generates a collection (rdf:List) or container (rdf:Bag, rdf:Seq, rdf:Alt).</rdfs:comment>
    <rdfs:label>Gather Map</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/cc/"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/rml/TermMap"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/null">
    <rdfs:domain rdf:resource="http://w3id.org/rml/Source"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/io/"/>
    <rdfs:label>null</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Describes which data values inside the source should be considered as NULL.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/cc/">
    <dcterms:license rdf:resource="http://purl.org/NET/rdflicense/cc-by4.0"/>
