    <rdfs:comment xml:lang="en">Represents a parameter map.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/subject">
    <rdfs:domain rdf:resource="http://w3id.org/rml/TriplesMap"/>
    <rdfs:comment xml:lang="en">An IRI reference for use as subject for all the RDF triples generated from a logical source record.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdfs:label>subject</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
