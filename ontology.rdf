  <rdf:Description rdf:about="http://w3id.org/rml/Encoding">
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/io/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Encoding class</rdfs:label>
    <rdfs:comment xml:lang="en">Represents encoding formats.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/return">
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/fnml/"/>
    <rdfs:comment xml:lang="en">Specifies the return output of a function.</rdfs:comment>
