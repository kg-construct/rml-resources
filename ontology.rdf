    <rdfs:label>Unsafe URI</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
    <rdfs:comment xml:lang="en">Denotes an unsafe URI, used with termType.</rdfs:comment>
