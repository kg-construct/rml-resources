    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://w3id.org/rml/Join"/>
    <rdfs:label>child</rdfs:label>
    <rdfs:comment xml:lang="en">Names a source record in the child source of a join.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/PredicateMap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/rml/core/"/>
