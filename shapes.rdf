    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7888aee1304b4e40b171952d76614cbab21">
    <rdf:first rdf:resource="http://w3id.org/rml/Write"/>
    <rdf:rest rdf:nodeID="n7888aee1304b4e40b171952d76614cbab22"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b97">
    <sh:path rdf:resource="http://w3id.org/rml/termType"/>
    <sh:in rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b98"/>
    <sh:message>
            rml:termType must be a rml:IRI, rml:UnsafeIRI, rml:URI,
            rml:UnsafeURI, or rml:BlankNode for a Subject Map.
            </sh:message>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b53">
    <sh:or rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b57"/>
    <sh:path rdf:resource="http://w3id.org/rml/objectMap"/>
    <rdfs:comment>
            An ObjectMap element to generate the object component of the 
            (predicate, object) pair from a logical table row or iterator.
            </rdfs:comment>
    <sh:message>
            rml:objectMap must be an IRI or blank node and be provided once.
            </sh:message>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/objectMap"/>
    <rdfs:label>objectMap</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b9">
    <rdf:first rdf:resource="http://w3id.org/rml/UnsafeIRI"/>
    <rdf:rest rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b10"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b14">
    <rdf:rest rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b15"/>
    <rdf:first rdf:resource="http://w3id.org/rml/shapes/RMLLogicalTargetPropertiesShape"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n45f0c41eeca54b93b46ea7c95c34796eb14">
    <sh:xone rdf:nodeID="n45f0c41eeca54b93b46ea7c95c34796eb17"/>
    <sh:message>
            An Quoted Triples Map may never be used for generating a predicate.
            </sh:message>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/predicateObjectMap"/>
    <sh:name>PredicateMap</sh:name>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b69">
    <rdf:rest rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b70"/>
    <rdf:first rdf:resource="http://w3id.org/rml/append"/>
  </rdf:Description>
