    <rdf:first rdf:resource="http://w3id.org/rml/parentMap"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n2d4cf3bfe11241c894a0dbe75d4fd53cb4">
    <sh:node rdf:resource="http://w3id.org/rml/shapes/IterableFieldShape"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b47">
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <rdfs:comment>
            Specifies the predicate for the generated triple from the logical table 
            row or iterator.
            </rdfs:comment>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/predicate"/>
    <sh:message>
            rml:predicate must be an IRI and be provided once.
            </sh:message>
    <sh:path rdf:resource="http://w3id.org/rml/predicate"/>
    <rdfs:label>predicate</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n45f0c41eeca54b93b46ea7c95c34796eb3">
    <sh:node rdf:resource="http://w3id.org/rml/shapes/RMLAssertedTriplesMapShape"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n45f0c41eeca54b93b46ea7c95c34796eb8">
    <rdf:rest rdf:nodeID="n45f0c41eeca54b93b46ea7c95c34796eb9"/>
    <rdf:first rdf:resource="http://w3id.org/rml/AssertedTriplesMap"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n45f0c41eeca54b93b46ea7c95c34796eb1">
    <sh:path rdf:resource="http://w3id.org/rml/predicateObjectMap"/>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:message>
            Exactly one Predicate Object Map must be specified in the
            Triples Map referenced by rml:quotedTriplesMap.
            </sh:message>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b130">
    <rdf:first rdf:resource="http://w3id.org/rml/UnsafeIRI"/>
    <rdf:rest rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b131"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b84">
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
    <rdfs:comment>
            Language tag for the object.
            </rdfs:comment>
    <sh:path rdf:resource="http://w3id.org/rml/language"/>
    <rdfs:label>language</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLNonAssertedTriplesMapShape">
    <rdfs:comment>
    Represents a Non Asserted Triples Map.
    </rdfs:comment>
    <sh:message>
    Non Asserted Triples Map requires exactly one rml:subject or 
    one rml:subjectMap and zero or more rml:predicateObjectMaps
    and exactly one rml:logicalSource.
    </sh:message>
    <sh:message>NonAssertedTriplesMap</sh:message>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:and rdf:nodeID="n45f0c41eeca54b93b46ea7c95c34796eb26"/>
    <sh:targetClass rdf:resource="http://w3id.org/rml/NonAssertedTriplesMap"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b7">
    <sh:in rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b8"/>
    <sh:message>
            rml:termType must be an rml:IRI, rml:UnsafeIRI, rml:URI,
            rml:UnsafeURI, or rml:BlankNode for a Graph Map.
            </sh:message>
    <sh:path rdf:resource="http://w3id.org/rml/termType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/ExpressionFieldShape">
    <sh:message>
    Node must have a valid rml:ExpressionField description.
    rml:ExpressionField requires what an rml:ExpressionMap and rml:Field requires.
    </sh:message>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:label>Expression Field</rdfs:label>
    <sh:node rdf:resource="http://w3id.org/rml/shapes/RMLExpressionMapShape"/>
    <rdfs:comment>
    A expression field is an expression map that gives a name to an expression.
    </rdfs:comment>
    <sh:property rdf:nodeID="n2d4cf3bfe11241c894a0dbe75d4fd53cb16"/>
    <sh:property rdf:nodeID="n2d4cf3bfe11241c894a0dbe75d4fd53cb17"/>
    <sh:targetClass rdf:resource="http://w3id.org/rml/ExpressionField"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n35a43d8e3f4e4494b764f8cc822e7a71b26">
    <rdf:rest rdf:nodeID="n35a43d8e3f4e4494b764f8cc822e7a71b27"/>
    <rdf:first rdf:resource="http://w3id.org/rml/shapes/RMLLogicalTargetPropertiesShape"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b6">
    <rdf:first rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b4"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n45f0c41eeca54b93b46ea7c95c34796eb2">
    <sh:or rdf:nodeID="n45f0c41eeca54b93b46ea7c95c34796eb5"/>
    <sh:message>
            rml:quotedTriplesMap expects either a rml:AssertedTriplesMap 
            or rml:NonAssertedTriplesMap.
            </sh:message>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7888aee1304b4e40b171952d76614cbab9">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
