<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:sh="http://www.w3.org/ns/shacl#"
>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLChildMapShape">
    <rdfs:comment>
    Represents a Child Map.
    </rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:and rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb2"/>
    <sh:message>
    rml:ChildMap must specify a literal referencing data in the child data
    source.
    </sh:message>
    <sh:targetObjectsOf rdf:resource="http://www.w3.org/ns/r2rml#childMap"/>
    <sh:targetClass rdf:resource="http://www.w3.org/ns/r2rml#ChildMap"/>
    <rdfs:label>ChildMap</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n89aa961460604cb69537555e6da76dadb10">
    <rdf:rest rdf:nodeID="n89aa961460604cb69537555e6da76dadb11"/>
    <rdf:first rdf:nodeID="n89aa961460604cb69537555e6da76dadb1"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b14">
    <rdfs:label>rml:null</rdfs:label>
    <sh:path rdf:resource="http://w3id.org/rml/null"/>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:minCount>
    <sh:message>
        rml:null must be provided as a Literal.
        </sh:message>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
    <rdfs:comment>
        rml:null specifies which data values inside the source should be 
        considered as NULL. Defaults to the default NULL character of a source,
        if available.
        </rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6da6acf206d845b6930e27bc4b6908b7b9">
    <rdf:first rdf:resource="http://w3id.org/rml/shapes/RMLTermMapShape"/>
    <rdf:rest rdf:nodeID="n6da6acf206d845b6930e27bc4b6908b7b10"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb8">
    <sh:message>
        The value of a rml:innerJoin property for a rml:LogicalView must be a resource.
        </sh:message>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:description>
        An inner join of the logical view.
        </sh:description>
    <sh:path rdf:resource="http://w3id.org/rml/innerJoin"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n89aa961460604cb69537555e6da76dadb8">
    <rdf:rest rdf:nodeID="n89aa961460604cb69537555e6da76dadb9"/>
    <rdf:first rdf:resource="http://w3id.org/rml/AssertedTriplesMap"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb37">
    <rdf:first rdf:resource="http://w3id.org/rml/URI"/>
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb38"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b6">
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <rdfs:label>rml:path</rdfs:label>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
    <rdfs:comment>
        rml:path specifies the relative path to access for the source.
        </rdfs:comment>
    <sh:path rdf:resource="http://w3id.org/rml/path"/>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:message>
        rml:path must be a string Literal.
        </sh:message>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/LeafExpressionFieldShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:message>
    Node must have a valid rml:ExpressionField description.
    </sh:message>
    <rdfs:comment>
    A leaf expression field is an expression field without nested fields.
    </rdfs:comment>
    <sh:property rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb23"/>
    <rdfs:label>Leaf Expression Field</rdfs:label>
    <sh:node rdf:resource="http://w3id.org/rml/shapes/ExpressionFieldShape"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6da6acf206d845b6930e27bc4b6908b7b7">
    <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>
            Defines the behavior when the collection is empty. True will generate
            a rdf:nil for a RDF collection or a resource with no members for an RDF
            container. False will not generate any collection or container.
            Default is false.
            </rdfs:comment>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:minCount>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <rdfs:label>allowEmptyListAndContainer</rdfs:label>
    <sh:path rdf:resource="http://w3id.org/rml/allowEmptyListAndContainer"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
    <sh:message>
            Zero or one rml:allowEmptyListAndContainer is required with datatype
            xsd:boolean.
            </sh:message>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b3">
    <rdf:first rdf:resource="http://w3id.org/rml/function"/>
    <rdf:rest rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b4"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb18">
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sh:path rdf:resource="http://w3id.org/rml/fieldName"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:message>
        Exactly one rml:fieldName property must be specified for a rml:Field, with a string as its value.
        </sh:message>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
    <sh:description>
        The name of the field.
        </sh:description>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLSourceShape">
    <sh:property rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b12"/>
    <sh:property rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b14"/>
    <sh:property rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b11"/>
    <sh:property rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b13"/>
    <sh:message>
    RML Source accepts one or multiple rml:null, one rml:compression,
    and one rml:encoding. All of them are optional.
    </sh:message>
    <sh:targetClass rdf:resource="http://w3id.org/rml/Source"/>
    <rdfs:comment>
    A source describes access to a data source. Any data access description
    is allowed, but rml:Source provides additional properties to complete
    such descriptions.
    </rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:label>RML Source</rdfs:label>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/source"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb2">
    <sh:message>
        At least one rml:field property must be specified for a rml:LogicalView, with either an rml:ExpressionField or an rml:IterableField its value.
        </sh:message>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:path rdf:resource="http://w3id.org/rml/field"/>
    <sh:or rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb5"/>
    <sh:description>
        A field of the logical view.
        </sh:description>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLGraphMapShape">
    <sh:message>
    rml:GraphMap must specify an rml:template, rml:reference or rml:constant 
    with the IRI of the Named Graph.
    </sh:message>
    <rdfs:comment>
    Represents a Graph Map.
    </rdfs:comment>
    <rdfs:label>GraphMap</rdfs:label>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/graphMap"/>
    <sh:targetClass rdf:resource="http://w3id.org/rml/GraphMap"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:and rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb13"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLAssertedTriplesMapShape">
    <sh:message>
    Asserted Triples Map requires exactly one rml:subject or 
    one rml:subjectMap and zero or more rml:predicateObjectMaps
    and exactly one rml:logicalSource.
    </sh:message>
    <sh:message>AssertedTriplesMap</sh:message>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment>
    Represents a Asserted Triples Map.
    </rdfs:comment>
    <sh:and rdf:nodeID="n89aa961460604cb69537555e6da76dadb23"/>
    <sh:targetClass rdf:resource="http://w3id.org/rml/AssertedTriplesMap"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb50">
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb51"/>
    <rdf:first rdf:resource="http://w3id.org/rml/object"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb122">
    <rdfs:comment>
        Either an rml:graph or rml:graphMap may be optionally be provided,
        but not both.
        </rdfs:comment>
    <sh:path rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb123"/>
    <rdfs:label>graph/graphMap</rdfs:label>
    <sh:message>
        Either an rml:graph or rml:graphMap may be optionally be provided,
        but not both.
        </sh:message>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:minCount>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb53">
    <sh:path rdf:resource="http://w3id.org/rml/objectMap"/>
    <sh:or rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb57"/>
    <sh:message>
            rml:objectMap must be an IRI or blank node and be provided once.
            </sh:message>
    <rdfs:label>objectMap</rdfs:label>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/objectMap"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <rdfs:comment>
            An ObjectMap element to generate the object component of the 
            (predicate, object) pair from a logical table row or iterator.
            </rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLobjectShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:label>object</rdfs:label>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/object"/>
    <rdfs:comment>
    An IRI, Blank Node, or Literal to use as object for all the RDF triples.
    </rdfs:comment>
    <sh:message>
    rml:object shortcut for rml:objectMap must be an IRI, Blank Node, 
    or Literal.
    </sh:message>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLInputShape">
    <sh:property rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b19"/>
    <sh:property rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b18"/>
    <sh:property rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b17"/>
    <sh:property rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b12"/>
    <sh:property rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b20"/>
    <sh:property rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b16"/>
    <rdfs:label>rml:Input</rdfs:label>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/input"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment>
    Represents an Input for a function.
    </rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb132">
    <rdf:first rdf:resource="http://w3id.org/rml/UnsafeURI"/>
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb133"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLTriplesMapPropertiesShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb109"/>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb117"/>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb112"/>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb111"/>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb110"/>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb108"/>
    <sh:targetClass rdf:resource="http://w3id.org/rml/NonAssertedTriplesMap"/>
    <sh:targetClass rdf:resource="http://w3id.org/rml/TriplesMap"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n89aa961460604cb69537555e6da76dadb19">
    <rdf:first rdf:resource="http://w3id.org/rml/shapes/RMLJoinConditionPropertiesShape"/>
    <rdf:rest rdf:nodeID="n89aa961460604cb69537555e6da76dadb20"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb23">
    <rdfs:label>parent</rdfs:label>
    <rdfs:comment>
        Specifies the parent of the object component for joining.
        </rdfs:comment>
    <sh:path rdf:resource="http://w3id.org/rml/parent"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/parent"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b11">
    <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sh:message>
        rml:source must be provided as a string Literal.
        </sh:message>
    <rdfs:comment>
        rml:null specifies how NULL or empty values are exposed by the data 
        source.
        </rdfs:comment>
    <sh:path rdf:resource="http://w3id.org/rml/null"/>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:minCount>
    <rdfs:label>rml:null</rdfs:label>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb105">
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb106"/>
    <rdf:first rdf:resource="http://w3id.org/rml/shapes/RMLLogicalTargetPropertiesShape"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLNonAssertedTriplesMapShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:and rdf:nodeID="n89aa961460604cb69537555e6da76dadb26"/>
    <rdfs:comment>
    Represents a Non Asserted Triples Map.
    </rdfs:comment>
    <sh:message>
    Non Asserted Triples Map requires exactly one rml:subject or 
    one rml:subjectMap and zero or more rml:predicateObjectMaps
    and exactly one rml:logicalSource.
    </sh:message>
    <sh:message>NonAssertedTriplesMap</sh:message>
    <sh:targetClass rdf:resource="http://w3id.org/rml/NonAssertedTriplesMap"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb82">
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <rdfs:comment>
            Specified the language map for the object component for the 
            generated RDF triples.
            </rdfs:comment>
    <sh:path rdf:resource="http://w3id.org/rml/languageMap"/>
    <sh:message>
            rml:languageMap must point to a rml:LanguageMap specifying the 
            language tag of the string Literal.
            </sh:message>
    <rdfs:label>languageMap</rdfs:label>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/languageMap"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb123">
    <sh:alternativePath rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb124"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLLanguageMapShape">
    <rdfs:label>LanguageMap</rdfs:label>
    <sh:targetClass rdf:resource="http://w3id.org/rml/LanguageMap"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:and rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb29"/>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/languageMap"/>
    <rdfs:comment>
    Represents a Language Map.
    </rdfs:comment>
    <sh:message>
    rml:LanguageMap must specify an rml:template, rml:reference, or rml:constant
    with the BCP47 name of the language as string.
    </sh:message>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLSubjectMapShape">
    <sh:and rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb103"/>
    <rdfs:comment>
    Represents a Subject Map.
    </rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:message>
    Subject Map must generate a resource representing the subject of
    an RDF triple.
    </sh:message>
    <sh:targetClass rdf:resource="http://w3id.org/rml/SubjectMap"/>
    <rdfs:label>SubjectMap</rdfs:label>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/subjectMap"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb96">
    <sh:path rdf:resource="http://w3id.org/rml/class"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/class"/>
    <rdfs:label>class</rdfs:label>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:message>
            rml:class must be an IRI and may be specified multiple times.
            </sh:message>
    <rdfs:comment>
            The subject value generated will be asserted as an instance of this
            RDFS class.
            </rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb33">
    <rdf:first rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb31"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb11">
    <sh:or rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb14"/>
    <sh:message>
        The value of a rml:field property for a rml:Field must be a resource.
        </sh:message>
    <sh:path rdf:resource="http://w3id.org/rml/field"/>
    <sh:description>
        A child field of the field.
        </sh:description>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/IterableFieldShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:property rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb18"/>
    <sh:property rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb19"/>
    <sh:message>
    Node must have a valid rml:IterableField description.
    rml:IterableField must have one or more rml:field properties.
    Furthermore, rml:IterableField requires what an rml:Iterable and rml:Field requires.
    </sh:message>
    <sh:node rdf:resource="http://w3id.org/rml/shapes/RMLIterableShape"/>
    <sh:targetClass rdf:resource="http://w3id.org/rml/IterableField"/>
    <rdfs:label>Iterable Field</rdfs:label>
    <rdfs:comment>
    An iterable field is a construction that gives a name to logical iterations derived from the parent of the field.
    </rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb78">
    <rdf:first rdf:resource="http://w3id.org/rml/languageMap"/>
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb79"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb21">
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/child"/>
    <rdfs:label>child</rdfs:label>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
    <rdfs:comment>
        Specifies the child of the object component for joining.
        </rdfs:comment>
    <sh:path rdf:resource="http://w3id.org/rml/child"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLgraphShape">
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/graph"/>
    <sh:message>
    rml:graph must be an IRI or blank node.
    </sh:message>
    <rdfs:comment>
    An IRI reference for use as the graph name of all triples generated with 
    the Graph Map. 
    </rdfs:comment>
    <rdfs:label>graph</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb128">
    <rdfs:comment>
            An IRI indicating whether a generated term should be an IRI, 
            Blank Node, or a Literal.
            </rdfs:comment>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:in rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb129"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/termType"/>
    <rdfs:label>termType</rdfs:label>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:path rdf:resource="http://w3id.org/rml/termType"/>
    <sh:message>
            rml:termType must be either rml:IRI, rml:UnsafeIRI,
            rml:URI, rml:UnsafeURI, rml:Literal, or rml:BlankNode for a Term Map.
            May only be provided once.
            </sh:message>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLJoinShape">
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb24"/>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb21"/>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb20"/>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb22"/>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb23"/>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb16"/>
    <rdfs:label>Join</rdfs:label>
    <rdfs:comment>
    Represents a Join.
    </rdfs:comment>
    <sh:targetClass rdf:resource="http://w3id.org/rml/Join"/>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/joinCondition"/>
    <sh:message>
    rml:Join must specify exactly one rml:parent/rml:parentMap 
    and rml:child/rml:childMap.
    </sh:message>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLFunctionExecutionShape">
    <sh:property rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b1"/>
    <sh:property rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b7"/>
    <sh:property rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b5"/>
    <sh:property rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b6"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/functionExecution"/>
    <rdfs:label>rml:FunctionExecution</rdfs:label>
    <rdfs:comment>
    Represents a Function Execution.
    </rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb52">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="http://w3id.org/rml/quotedTriplesMap"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLStrategyAppendShape">
    <rdfs:label>Strategy</rdfs:label>
    <sh:message>
    Strategy must be either rml:append or rml:cartesianProduct.
    </sh:message>
    <sh:in rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb69"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment>
    Strategy to follow when generating RDF triples.
    </rdfs:comment>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/strategy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/LogicalViewJoinShape">
    <rdfs:label>LogicalViewJoin</rdfs:label>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/leftJoin"/>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/innerJoin"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:targetClass rdf:resource="http://w3id.org/rml/LogicalViewJoin"/>
    <rdfs:comment>
    A LogicalViewJoin is an operation that adapts the logical iterations of one logical view (the child logical view) with fields from another logical view (the parent logical view).
    </rdfs:comment>
    <sh:message>
    Node must have a valid rml:LogicalViewJoin description.
    rml:LogicalViewJoin requires:
    - exactly one rml:parentLogicalView property.
    - one or more rml:joinCondition properties.
    - one or more rml:field properties.
    Furthermore, rml:Field requires what an rml:ExpressionMap requires.
    </sh:message>
    <sh:property rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb22"/>
    <sh:property rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb20"/>
    <sh:property rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb21"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb17">
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:description>
        A child field of the field.
        </sh:description>
    <sh:message>
        The value of a rml:field property for a rml:Field must be a resource.
        </sh:message>
    <sh:path rdf:resource="http://w3id.org/rml/field"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b10">
    <sh:path rdf:resource="http://w3id.org/rml/path"/>
    <rdfs:label>rml:path</rdfs:label>
    <sh:message>
        rml:path must be a string Literal.
        </sh:message>
    <rdfs:comment>
        rml:path specifies the relative path to access for the target.
        </rdfs:comment>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb84">
    <rdfs:label>language</rdfs:label>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
    <rdfs:comment>
            Language tag for the object.
            </rdfs:comment>
    <sh:path rdf:resource="http://w3id.org/rml/language"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLObjectMapShape">
    <rdfs:comment>
    Represents an Object Map.
    </rdfs:comment>
    <sh:message>
    Object Map must generate a IRI, Blank Node, or Literal which has optionally
    a language tag or datatype.
    </sh:message>
    <sh:targetClass rdf:resource="http://w3id.org/rml/ObjectMap"/>
    <rdfs:label>ObjectMap</rdfs:label>
    <sh:and rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb86"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLIterableShape">
    <sh:message>
    Iterable must specify how to generate logical iterations on a data source.
    </sh:message>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb75"/>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb74"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:label>Iterable</rdfs:label>
    <sh:targetClass rdf:resource="http://w3id.org/rml/Iterable"/>
    <rdfs:comment>
    An abstract construct to describe data access and iteration for a data source.
    </rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b11">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b8"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLPredicateObjectMapShape">
    <rdfs:label>PredicateObjectMap</rdfs:label>
    <sh:targetClass rdf:resource="http://w3id.org/rml/PredicateObjectMap"/>
    <rdfs:comment>
    Represents a Predicate Object Map.
    </rdfs:comment>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/predicateObjectMap"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:and rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb61"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb16">
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <rdfs:comment>
        rml:parent/rml:parentMap may only be provided once and 
        not at the same time.
        </rdfs:comment>
    <sh:path rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb17"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <rdfs:label>parentMap/parent</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6da6acf206d845b6930e27bc4b6908b7b8">
    <rdfs:label>gather</rdfs:label>
    <sh:path rdf:resource="http://w3id.org/rml/gather"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:message>
            one or more rml:gather properties are needed, each pointing to a
            RML Term Map.
            </sh:message>
    <rdfs:comment>
            RML Term Maps to gather in the collection or container.
            </rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb99">
    <rdf:first rdf:resource="http://w3id.org/rml/UnsafeIRI"/>
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb100"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb152">
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/functionExecution"/>
    <sh:message>
        rml:functionExecution must be an IRI;
        </sh:message>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:path rdf:resource="http://w3id.org/rml/functionExecution"/>
    <rdfs:comment>
        A Function Execution rml:functionExecution is used to define the FnO 
        function to execute from the RML-FNML specification. RML Core only 
        validates if the property is present and has the right node kind.
        The actual validation happens with RML-FNML SHACL shapes.
        </rdfs:comment>
    <rdfs:label>functionExecution</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b7">
    <sh:path rdf:resource="http://w3id.org/rml/root"/>
    <sh:in rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b8"/>
    <sh:message>
        rml:root must be either rml:CurrentWorkingDirectory or
        rml:MappingDirectory.
        </sh:message>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <rdfs:label>rml:root</rdfs:label>
    <rdfs:comment>
        rml:root defines the root directory against which relative paths are
        resolved. If not provided, defaults to the current working directory.
        </rdfs:comment>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:minCount>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLlanguageShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:pattern>^((?:(en-GB-oed|i-ami|i-bnn|i-default|i-enochian|i-hak|i-klingon|i-lux|i-mingo|i-navajo|i-pwn|i-tao|i-tay|i-tsu|sgn-BE-FR|sgn-BE-NL|sgn-CH-DE)|(art-lojban|cel-gaulish|no-bok|no-nyn|zh-guoyu|zh-hakka|zh-min|zh-min-nan|zh-xiang))|((?:([A-Za-z]{2,3}(-(?:[A-Za-z]{3}(-[A-Za-z]{3}){0,2}))?)|[A-Za-z]{4})(-(?:[A-Za-z]{4}))?(-(?:[A-Za-z]{2}|[0-9]{3}))?(-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(-(?:[0-9A-WY-Za-wy-z](-[A-Za-z0-9]{2,8})+))*(-(?:x(-[A-Za-z0-9]{1,8})+))?)|(?:x(-[A-Za-z0-9]{1,8})+))$</sh:pattern>
    <rdfs:label>language</rdfs:label>
    <rdfs:comment>
    Specified the language for the generated Literal.
    </rdfs:comment>
    <sh:message>
    rml:language must be a valid language tag according to BCP47 and may
    only be provided once as string.
    </sh:message>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/language"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLExpressionMapShape">
    <rdfs:label>ExpressionMap</rdfs:label>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb145"/>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb155"/>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb154"/>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb151"/>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb153"/>
    <sh:property rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb152"/>
    <sh:or rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb143"/>
    <rdfs:comment>
    Represents a Expression Map.
    </rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:message>
    Expression Map may require one rml:template or one rml:constant or one
    rml:reference.
    </sh:message>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLparentShape">
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/parent"/>
    <sh:message>
    rml:parent shortcut for rml:ParentMap must be a Literal.
    </sh:message>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
    <rdfs:comment>
    A Literal reference to use as reference to the parent data source.
    </rdfs:comment>
    <rdfs:label>parent</rdfs:label>
    <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb20">
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:description>
        The parent logical view of the logical view join.
        </sh:description>
    <sh:path rdf:resource="http://w3id.org/rml/parentLogicalView"/>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:message>
        Exactly one rml:parentLogicalView property must be specified for a rml:LogicalViewJoin, with a resource as its value.
        </sh:message>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb34">
    <sh:in rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb35"/>
    <sh:path rdf:resource="http://w3id.org/rml/termType"/>
    <sh:message>
            rml:termType for Predicate Map can only be a rml:IRI, rml:UnsafeIRI,
            rml:URI, or rml:UnsafeURI;
            </sh:message>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLRefObjectMapShape">
    <rdfs:label>RefObjectMap</rdfs:label>
    <rdfs:comment>
    Represents a Reference Object Map.
    </rdfs:comment>
    <sh:targetClass rdf:resource="http://w3id.org/rml/RefObjectMap"/>
    <sh:and rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb94"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:message>
    rml:RefObjectMap must specify a rml:parentTriplesMap and zero or more 
    rml:joinConditions.
    </sh:message>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb64">
    <rdf:first rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb46"/>
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb65"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb25">
    <sh:alternativePath rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb26"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb150">
    <rdf:first rdf:resource="http://w3id.org/rml/functionExecution"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/ExpressionFieldShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment>
    A expression field is an expression map that gives a name to an expression.
    </rdfs:comment>
    <rdfs:label>Expression Field</rdfs:label>
    <sh:property rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb17"/>
    <sh:property rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb16"/>
    <sh:targetClass rdf:resource="http://w3id.org/rml/ExpressionField"/>
    <sh:message>
    Node must have a valid rml:ExpressionField description.
    rml:ExpressionField requires what an rml:ExpressionMap and rml:Field requires.
    </sh:message>
    <sh:node rdf:resource="http://w3id.org/rml/shapes/RMLExpressionMapShape"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb95">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb93"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b12">
    <rdfs:label>rml:parameter/rml:parameterMap</rdfs:label>
    <sh:message>
        Exactly one rml:parameter or rml:parameterMap is required.
        </sh:message>
    <rdfs:comment>
        Exactly one rml:parameter or rml:parameterMap is required.
        </rdfs:comment>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:path rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b13"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLFunctionMapShape">
    <rdfs:label>FunctionMap</rdfs:label>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/functionMap"/>
    <sh:and rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b9"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment>
    Represents a Function Map.
    </rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb59">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb56"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb141">
    <sh:path rdf:resource="http://w3id.org/rml/returnMap"/>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb68">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb60"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLTargetShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:targetClass rdf:resource="http://w3id.org/rml/Target"/>
    <sh:property rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b18"/>
    <sh:property rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b16"/>
    <sh:property rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b17"/>
    <sh:property rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b15"/>
    <sh:message>
    RML Target accepts one rml:compression, and one rml:encoding.
    All of them are optional.
    </sh:message>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/target"/>
    <rdfs:comment>
    A target describes access to a data target. Any data access description
    is allowed, but rml:Target provides additional properties to complete
    such descriptions.
    </rdfs:comment>
    <rdfs:label>RML Target</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb92">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb85"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLParameterMapShape">
    <sh:and rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b25"/>
    <rdfs:comment>
    Represents a Parameter Map of a function.
    </rdfs:comment>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/parameterMap"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:label>ParameterMap</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/FieldShape">
    <sh:targetClass rdf:resource="http://w3id.org/rml/Field"/>
    <rdfs:label>Field</rdfs:label>
    <sh:property rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb10"/>
    <sh:property rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb11"/>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/field"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:message>
    Node must have a valid rml:Field description.
    rml:Field requires a rml:fieldName and may have zero or more rml:field properties.
    Furthermore, subclass rml:ExpressionField requires what an rml:ExpressionMap requires, subclass rml:IterableField requires what an rml:Iterable requires,.
    </sh:message>
    <rdfs:comment>
    A field is a construct that gives a name to data derived from an abstract logical source.
    </rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6da6acf206d845b6930e27bc4b6908b7b6">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Seq"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b12">
    <sh:message>
        rml:compression must be provided as an IRI.
        </sh:message>
    <rdfs:label>rml:compression</rdfs:label>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:minCount>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <rdfs:comment>
        rml:compression specifies the compression algorithm to use when
        accessing the data source. By default, no compression is applied.
        </rdfs:comment>
    <sh:path rdf:resource="http://w3id.org/rml/compression"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLJoinConditionPropertiesShape">
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/joinCondition"/>
    <rdfs:label>joinCondition</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:message>
    rml:joinCondition must specify an rml:parent and rml:child.
    </sh:message>
    <sh:path rdf:resource="http://w3id.org/rml/joinCondition"/>
    <rdfs:comment>
    Specifies the join condition for joining a child data source with 
    a parent data source of the foreign key constraint.
    </rdfs:comment>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb19">
    <sh:message>
        The value of a rml:field property for a rml:Field must be a resource that describes an rml:ExpressionField.
        </sh:message>
    <sh:description>
        A child field of the iterable field.
        </sh:description>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:path rdf:resource="http://w3id.org/rml/field"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb115">
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb116"/>
    <rdf:first rdf:resource="http://w3id.org/rml/subject"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb117">
    <sh:or rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb120"/>
    <rdfs:label>subjectMap</rdfs:label>
    <sh:message>
        rml:SubjectMap must be an IRI or blank node.
        </sh:message>
    <rdfs:comment>
        A Subject Map element to generate a subject for generated RDF triples.
        </rdfs:comment>
    <sh:path rdf:resource="http://w3id.org/rml/subjectMap"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/subjectMap"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b3">
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:message>
        rml:root must be either rml:CurrentWorkingDirectory or
        rml:MappingDirectory.
        </sh:message>
    <sh:path rdf:resource="http://w3id.org/rml/root"/>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:minCount>
    <sh:in rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b4"/>
    <rdfs:label>rml:root</rdfs:label>
    <rdfs:comment>
        rml:root defines the root directory against which relative paths are
        resolved. If not provided, defaults to the current working directory.
        </rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLRelativePathTargetShape">
    <sh:targetClass rdf:resource="http://w3id.org/rml/RelativePathTarget"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment>
    A RML Relative Path Target provides a target with relative paths which is
    not provided by existing vocabularies such as DCAT without a base IRI.
    </rdfs:comment>
    <sh:message>
    RML Relative Path Target accepts one rml:root, and one rml:path.
    rml:root is optional and defaults to rml:CurrentWorkingDirectory.
    </sh:message>
    <sh:property rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b7"/>
    <sh:property rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b10"/>
    <rdfs:label>RML Relative Path Target</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb112">
    <sh:path rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb113"/>
    <sh:message>
        Either a rml:subject, rml:subjectMap or a rml:quotedTriplesMap is required, not multiple.
        </sh:message>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/subjectMap"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/quotedTriplesMap"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/subject"/>
    <rdfs:comment>
        Either a rml:subject, rml:subjectMap or a rml:quotedTriplesMap is required, not multiple.
        </rdfs:comment>
    <rdfs:label>subjectMap/subject/quotedTriplesMap</rdfs:label>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb106">
    <rdf:first rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb96"/>
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb107"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b2">
    <sh:node rdf:resource="http://w3id.org/rml/shapes/RMLTargetShape"/>
    <rdfs:comment>
        The target (rml:target) locates the output target. It is a URI
        that represents the target where it must export generated RDF triples
        to.
        </rdfs:comment>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:path rdf:resource="http://w3id.org/rml/target"/>
    <rdfs:label>rml:target</rdfs:label>
    <sh:message>
        rml:target must be provided to locate the target. rml:target must 
        be provided exactly once as an URI.
        </sh:message>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b6">
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:path rdf:resource="http://w3id.org/rml/function"/>
    <rdfs:label>rml:function</rdfs:label>
    <sh:message>
        rml:function must be an IRI.
        </sh:message>
    <rdfs:comment>
        FnO function to execute.
        </rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLAbstractLogicalSourceShape">
    <rdfs:comment>
    A sub-class of iterable that can be associated with a triples map such that a data source can be mapped to RDF triples.
    </rdfs:comment>
    <sh:node rdf:resource="http://w3id.org/rml/shapes/RMLIterableShape"/>
    <sh:message>
    rml:AbstractLogicalSource must specify how to generate logical iterations on a data source for a triples map.
    </sh:message>
    <sh:targetClass rdf:resource="http://w3id.org/rml/AbstractLogicalSource"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:label>Abstract Logical Source</rdfs:label>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/logicalSource"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb6">
    <rdf:first rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb4"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b17">
    <rdfs:label>rml:inputValue</rdfs:label>
    <sh:message>
        rml:inputValue must be a string Literal.
        </sh:message>
    <rdfs:comment>
        Parameters to supply to FnO function.
        </rdfs:comment>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
    <sh:path rdf:resource="http://w3id.org/rml/inputValue"/>
    <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb20">
    <sh:path rdf:resource="http://w3id.org/rml/childMap"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/childMap"/>
    <sh:message>
        rml:childMap must point to a rml:ChildMap specifying the
        child of the Literal.
        </sh:message>
    <rdfs:comment>
        Specifies the child of the object component for joining.
        </rdfs:comment>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <rdfs:label>childMap</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb22">
    <rdfs:comment>
        Specifies the parent of the object component for joining.
        </rdfs:comment>
    <rdfs:label>parentMap</rdfs:label>
    <sh:path rdf:resource="http://w3id.org/rml/parentMap"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/parentMap"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:message>
        rml:parentMap must point to a rml:ParentMap specifying the 
        parent tag of the string Literal.
        </sh:message>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb121">
    <rdf:first rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb119"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb80">
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb81"/>
    <rdf:first rdf:resource="http://w3id.org/rml/language"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLDatatypeMapShape">
    <sh:message>
    rml:DatatypeMap must specify an rml:template, rml:reference, or rml:constant
    with the IRI of the datatype.
    </sh:message>
    <rdfs:label>DatatypeMap</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:and rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb5"/>
    <sh:targetClass rdf:resource="http://w3id.org/rml/DatatypeMap"/>
    <rdfs:comment>
    Represents a Datatype Map.
    </rdfs:comment>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/datatypeMap"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb7">
    <sh:path rdf:resource="http://w3id.org/rml/termType"/>
    <sh:in rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb8"/>
    <sh:message>
            rml:termType must be an rml:IRI, rml:UnsafeIRI, rml:URI,
            rml:UnsafeURI, or rml:BlankNode for a Graph Map.
            </sh:message>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLsubjectShape">
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/subject"/>
    <rdfs:label>subject</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:message>
    rml:subject shortcut for rml:SubjectMap must be a IRI or BlankNode.
    </sh:message>
    <rdfs:comment>
    An IRI reference to use as subject for all the RDF triples.
    </rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb155">
    <sh:message>
        rml:reference must be a string.
        </sh:message>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
    <sh:path rdf:resource="http://w3id.org/rml/reference"/>
    <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/reference"/>
    <rdfs:comment>
        A reference rml:reference is used to refer to a column in case of 
        databases, a record in case of CSV or TSV data source, an element in 
        case of XML data source, an object in case of a JSON data source, etc.

        A reference must be a valid identifier, considering the reference 
        formulation (rml:referenceFormulation) specified. The reference can be
        an absolute path, or a path relative to the iterator specified at the 
        logical source. 
        </rdfs:comment>
    <rdfs:label>reference</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb32">
    <rdf:first rdf:resource="http://w3id.org/rml/shapes/RMLExpressionMapShape"/>
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb33"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/joinCyclesShape">
    <sh:sparql rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb28"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/viewOn"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb136">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb128"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb93">
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:path rdf:resource="http://w3id.org/rml/parentTriplesMap"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:class rdf:resource="http://w3id.org/rml/TriplesMap"/>
    <rdfs:comment>
            Specifies the Triples Map element corresponding to the parent data
            source of the foreign key constraint.
            </rdfs:comment>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/parentTriplesMap"/>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:message>
            rml:parentTriplesMap may only be provided once and must be an IRI
            or Blank Node referring to a Triples Map.
            </sh:message>
    <rdfs:label>parentTriplesMap</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb91">
    <rdf:first rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb84"/>
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb92"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb16">
    <sh:path rdf:resource="http://w3id.org/rml/fieldName"/>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:message>
        Exactly one rml:fieldName property must be specified for a rml:Field, with a string as its value.
        </sh:message>
    <sh:description>
        The name of the field.
        </sh:description>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b19">
    <rdfs:label>rml:parameter</rdfs:label>
    <sh:path rdf:resource="http://w3id.org/rml/parameter"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <rdfs:comment>
        Parameters to supply to FnO function.
        </rdfs:comment>
    <sh:message>
        rml:parameter must be an IRI.
        </sh:message>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/parentCyclesShape">
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/field"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/viewOn"/>
    <sh:sparql rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb27"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n89aa961460604cb69537555e6da76dadb21">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="n89aa961460604cb69537555e6da76dadb14"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb130">
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb131"/>
    <rdf:first rdf:resource="http://w3id.org/rml/UnsafeIRI"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n89aa961460604cb69537555e6da76dadb15">
    <sh:path rdf:resource="http://w3id.org/rml/predicate"/>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b23">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="http://w3id.org/rml/inputValueMap"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb28">
    <sh:path rdf:resource="http://w3id.org/rml/constant"/>
    <sh:pattern>^((?:(en-GB-oed|i-ami|i-bnn|i-default|i-enochian|i-hak|i-klingon|i-lux|i-mingo|i-navajo|i-pwn|i-tao|i-tay|i-tsu|sgn-BE-FR|sgn-BE-NL|sgn-CH-DE)|(art-lojban|cel-gaulish|no-bok|no-nyn|zh-guoyu|zh-hakka|zh-min|zh-min-nan|zh-xiang))|((?:([A-Za-z]{2,3}(-(?:[A-Za-z]{3}(-[A-Za-z]{3}){0,2}))?)|[A-Za-z]{4})(-(?:[A-Za-z]{4}))?(-(?:[A-Za-z]{2}|[0-9]{3}))?(-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(-(?:[0-9A-WY-Za-wy-z](-[A-Za-z0-9]{2,8})+))*(-(?:x(-[A-Za-z0-9]{1,8})+))?)|(?:x(-[A-Za-z0-9]{1,8})+))$</sh:pattern>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b4">
    <rdf:first rdf:resource="http://w3id.org/rml/CurrentWorkingDirectory"/>
    <rdf:rest rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b5"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/io/shapes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:imports rdf:resource="http://w3id.org/rml/core/shapes"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLchildShape">
    <rdfs:label>child</rdfs:label>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
    <rdfs:comment>
    A Literal reference to use as reference to the child data source.
    </rdfs:comment>
    <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sh:message>
    rml:child shortcut for rml:ChildMap must be a Literal.
    </sh:message>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:targetObjectsOf rdf:resource="http://www.w3.org/ns/r2rml#child"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb46">
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/predicateMap"/>
    <rdfs:label>predicateMap</rdfs:label>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:message>
            rml:predicateMap must be an IRI or blank node and be provided once.
            </sh:message>
    <rdfs:comment>
            A PredicateMap element to generate the predicate component of the 
            (predicate, object) pair from a logical table row or iterator.
            </rdfs:comment>
    <sh:path rdf:resource="http://w3id.org/rml/predicateMap"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb125">
    <rdf:first rdf:resource="http://w3id.org/rml/graphMap"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb43">
    <sh:alternativePath rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb44"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb28">
    <sh:select>
            PREFIX rml: &lt;http://w3id.org/rml/&gt;
            SELECT ?this
            WHERE {
              ?this a rml:LogicalView .
              ?this ((rml:leftJoin|rml:innerJoin)/rml:parentLogicalView)+ ?this .
            }
        </sh:select>
    <sh:message>There must be no cycles via rml:viewOn and rml:leftJoin or rml:innerJoin.</sh:message>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb27">
    <rdf:first rdf:resource="http://w3id.org/rml/child"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb47">
    <sh:message>
            rml:predicate must be an IRI and be provided once.
            </sh:message>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/predicate"/>
    <rdfs:label>predicate</rdfs:label>
    <sh:path rdf:resource="http://w3id.org/rml/predicate"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <rdfs:comment>
            Specifies the predicate for the generated triple from the logical table 
            row or iterator.
            </rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLpredicateShape">
    <sh:message>
    rml:predicate must be an IRI.
    </sh:message>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment>
    Specifies the predicate for the generated triple.
    </rdfs:comment>
    <rdfs:label>predicate</rdfs:label>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/predicate"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb109">
    <sh:message>
        rml:subject must be an IRI or blank node.
        </sh:message>
    <sh:path rdf:resource="http://w3id.org/rml/subject"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <rdfs:label>subject</rdfs:label>
    <rdfs:comment>
        An IRI reference for use as subject for all generated RDF triples.
        </rdfs:comment>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/subject"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb60">
    <rdfs:label>object</rdfs:label>
    <sh:path rdf:resource="http://w3id.org/rml/object"/>
    <sh:message>
            rml:object must be an IRI and be provided once.
            </sh:message>
    <rdfs:comment>
            Specifies the object for the generated RDF triples.
            </rdfs:comment>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/object"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb143">
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb144"/>
    <rdf:first rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb137"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b18">
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:message>
        rml:mode must be specified by any of the modes from rml:Mode class.
        </sh:message>
    <rdfs:label>rml:mode</rdfs:label>
    <rdfs:comment>
        rml:mode specifies in which mode the target is opened such as read-only,
        write-only, both, etc.
        </rdfs:comment>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:minCount>
    <sh:in rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b19"/>
    <sh:path rdf:resource="http://w3id.org/rml/mode"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b29">
    <rdf:first rdf:resource="http://w3id.org/rml/shapes/RMLTermMapShape"/>
    <rdf:rest rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b30"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b8">
    <rdf:rest rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b9"/>
    <rdf:first rdf:resource="http://w3id.org/rml/CurrentWorkingDirectory"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b20">
    <rdfs:label>rml:inputValue/rml:inputValueMap</rdfs:label>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:message>
        Exactly one rml:inputValue or rml:inputValueMap is required.
        </sh:message>
    <rdfs:comment>
        Exactly one rml:inputValue or rml:inputValueMap is required.
        </rdfs:comment>
    <sh:path rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b21"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb74">
    <sh:message>
        rml:referenceFormulation must be a blank node or IRI specifying the 
        reference formulation on how to reference elements of a data source,
        and may be provided at most once.
        </sh:message>
    <sh:path rdf:resource="http://w3id.org/rml/referenceFormulation"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <rdfs:comment>
        The reference formulation (rml:referenceFormulation) defines how to 
        reference to elements of the data of the input source.
        </rdfs:comment>
    <rdfs:label>rml:referenceFormulation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb11">
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb12"/>
    <rdf:first rdf:resource="http://w3id.org/rml/UnsafeURI"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb1">
    <sh:path rdf:resource="http://w3id.org/rml/viewOn"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:message>
        Exactly one rml:viewOn property must be specified for a rml:LogicalView, with a rml:AbstractLogicalSource as its value.
        </sh:message>
    <sh:description>
        The source of the logical view. This is the logical source from which the logical view is derived.
        </sh:description>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:node rdf:resource="http://w3id.org/rml/shapes/RMLAbstractLogicalSourceShape"/>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb14">
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb15"/>
    <rdf:first rdf:resource="http://w3id.org/rml/shapes/RMLLogicalTargetPropertiesShape"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b16">
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <rdfs:label>rml:inputValueMap</rdfs:label>
    <sh:message>
        rml:inputValueMap must be an IRI or Blank node, provided once.
        </sh:message>
    <rdfs:comment>
        Values of the parameters.
        </rdfs:comment>
    <sh:path rdf:resource="http://w3id.org/rml/inputValueMap"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6da6acf206d845b6930e27bc4b6908b7b2">
    <sh:in rdf:nodeID="n6da6acf206d845b6930e27bc4b6908b7b3"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <rdfs:label>gatherAs</rdfs:label>
    <rdfs:comment>
            rml:gatherAs specifies how to gather the collection e.g. a rdf:Alt,
            rdf:List, rdf:Bag, or rdf:Seq.
            </rdfs:comment>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:path rdf:resource="http://w3id.org/rml/gatherAs"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:message>
            One rml:gatherAs is required.
            </sh:message>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n89aa961460604cb69537555e6da76dadb9">
    <rdf:first rdf:resource="http://w3id.org/rml/NonAssertedTriplesMap"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb145">
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:path rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb146"/>
    <sh:message>
        Exactly one rml:template, one rml:constant, one rml:reference,
        one rml:returnMap, or one rml:functionExecution is required.
        </sh:message>
    <rdfs:comment>
            Only one rml:template, one rml:constant, one rml:reference,
            or one rml:functionExecution is allowed. rml:returnMap is only allowed if rml:functionExecution is present.
        </rdfs:comment>
    <rdfs:label>template/constant/reference/functionExecution</rdfs:label>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/template"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/constant"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/functionExecution"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/reference"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLGatherMapShape">
    <sh:and rdf:nodeID="n6da6acf206d845b6930e27bc4b6908b7b9"/>
    <rdfs:comment>
    Represents a Gather Map.
    </rdfs:comment>
    <rdfs:label>GatherMap</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:message>
    Gather Map requires one rml:strategy, one rml:gatherAs, and a list of
    Term Map with rml:gather.
    </sh:message>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb75">
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:message>
        rml:iterator specifies the iterator to iterate over
        the data source, and may be provided at most once.
        </sh:message>
    <rdfs:comment>
        The logical iterator (rml:iterator) defines the iteration loop used to 
        map the data of the input source. Depends on the reference formulation
        if an iterator is necessary.  
        </rdfs:comment>
    <sh:path rdf:resource="http://w3id.org/rml/iterator"/>
    <rdfs:label>rml:iterator</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb39">
    <rdf:first rdf:resource="http://w3id.org/rml/shapes/RMLTermMapShape"/>
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb40"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb126">
    <rdfs:label>graphMap</rdfs:label>
    <sh:path rdf:resource="http://w3id.org/rml/graphMap"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:message>
        rml:graphMap must be either an IRI or blank node. 
        </sh:message>
    <rdfs:comment>
        Specifies a Graph Map. When used with a Subject Map element, all the
        RDF triples generated will be stored in the specified named graph.
        Otherwise, the RDF triple generated using the (predicate, object) 
        pair will be stored in the specified named graph.
        </rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb97">
    <sh:in rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb98"/>
    <sh:path rdf:resource="http://w3id.org/rml/termType"/>
    <sh:message>
            rml:termType must be a rml:IRI, rml:UnsafeIRI, rml:URI,
            rml:UnsafeURI, or rml:BlankNode for a Subject Map.
            </sh:message>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLTermMapShape">
    <sh:message>
    Term Map is an Expression Map with optionally a term type specified.
    </sh:message>
    <rdfs:comment>
    Represents a Term Map.
    </rdfs:comment>
    <sh:and rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb135"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:label>TermMap</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb26">
    <rdf:first rdf:resource="http://w3id.org/rml/childMap"/>
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb27"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/LogicalViewShape">
    <sh:property rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb1"/>
    <sh:property rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb2"/>
    <sh:property rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb7"/>
    <sh:property rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb8"/>
    <sh:property rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb9"/>
    <sh:message>
    Node must have a valid rml:LogicalView description.
    rml:LogicalView requires
    - exactly one rml:viewOn property, with a rml:AbstractLogicalSource as its value.
    - at least one rml:field property, with a rml:Field as its value.
    </sh:message>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/viewOn"/>
    <rdfs:comment>
    A logical view (rml:LogicalView) is a type of abstract logical source that is derived from another abstract logical source by defining fields with data from said abstract logical source.
    </rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:label>LogicalView</rdfs:label>
    <sh:targetClass rdf:resource="http://w3id.org/rml/LogicalView"/>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/parentLogicalView"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b20">
    <rdf:rest rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b21"/>
    <rdf:first rdf:resource="http://w3id.org/rml/ReadWrite"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/InclusionAnnotationShape">
    <rdfs:comment>
    The InclusionAnnotaton annotation (rml:InclusionAnnotation) is analogous to the notion of inclusion dependency in databases.
    </rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:label>InclusionAnnotation</rdfs:label>
    <sh:message>
    Node must have a valid rml:InclusionAnnotation description.
    Each InclusionAnnotation annotation requires (additionally to the inherited `rml:onFields` property):
    - Exactly one `rml:targetView` property
    - Exactly one `rml:targetFields` property.
    </sh:message>
    <sh:targetClass rdf:resource="http://w3id.org/rml/InclusionAnnotation"/>
    <sh:property rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb26"/>
    <sh:property rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb25"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb2">
    <rdf:rest rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb3"/>
    <rdf:first rdf:resource="http://w3id.org/rml/shapes/RMLExpressionMapShape"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLLogicalTargetPropertiesShape">
    <rdfs:label>logicalTarget</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:path rdf:resource="http://w3id.org/rml/logicalTarget"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/logicalTarget"/>
    <rdfs:comment>
    A logical target is any target to where generated RDF triples are
    exported to.
    </rdfs:comment>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:minCount>
    <sh:message>
    Zero or more rml:logicalTarget is required to export RDF triples.
    </sh:message>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndd7de0671de24887bb3ddfa1f2024624b18">
    <sh:path rdf:resource="http://w3id.org/rml/parameterMap"/>
    <rdfs:comment>
        Parameters to supply to FnO function.
        </rdfs:comment>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:node rdf:resource="http://w3id.org/rml/shapes/RMLParameterMap"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <rdfs:label>rml:parameterMap</rdfs:label>
    <sh:message>
        rml:parameterMap must be an IRI or Blank node.
        </sh:message>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b15">
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:minCount>
    <sh:path rdf:resource="http://w3id.org/rml/compression"/>
    <rdfs:comment>
        rml:compression specifies the compression algorithm to use when
        accessing the data target. By default, no compression is applied.
        </rdfs:comment>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
