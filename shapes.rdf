    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <rdfs:comment>
        rml:encoding specifies the encoding to use when accessing the data 
        source. By default, UTF-8 is used.
        </rdfs:comment>
    <sh:path rdf:resource="http://w3id.org/rml/encoding"/>
    <sh:message>
