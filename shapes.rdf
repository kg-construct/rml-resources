  <rdf:Description rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb27">
    <sh:message>There must be no cycles via rml:viewOn or rml:Field.</sh:message>
    <sh:select>
            PREFIX rml: &lt;http://w3id.org/rml/&gt;
            SELECT ?this
            WHERE {
              ?this (rml:viewOn|rml:field)+ ?this .
            }
        </sh:select>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
  </rdf:Description>
