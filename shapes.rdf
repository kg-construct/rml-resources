    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLParentMapShape">
    <rdfs:comment>
    Represents a Parent Map.
    </rdfs:comment>
    <sh:targetClass rdf:resource="http://w3id.org/rml/ParentMap"/>
    <sh:and rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b32"/>
    <rdfs:label>ParentMap</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:message>
    rml:ParentMap must specify a literal referencing data in the parent data
    source.
    </sh:message>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/parentMap"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b100">
    <rdf:rest rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b101"/>
    <rdf:first rdf:resource="http://w3id.org/rml/URI"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b89">
