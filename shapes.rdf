  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLStarMapShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment>
    Represents a Star Map.
    </rdfs:comment>
    <sh:message>
    Star Map requires exactly one rml:quotedTriplesMap and
    zero or more rml:joinCondition.
    </sh:message>
    <sh:message>StarMap</sh:message>
    <sh:and rdf:nodeID="n89aa961460604cb69537555e6da76dadb19"/>
    <sh:targetClass rdf:resource="http://w3id.org/rml/StarMap"/>
