        </sh:description>
    <sh:message>
        Exactly one rml:targetFields property must be specified for each rml:InclusionAnnotation.
        </sh:message>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb14">
    <rdf:rest rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb15"/>
    <rdf:first rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb12"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb22">
    <sh:path rdf:resource="http://w3id.org/rml/field"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:description>
        A field of the logical view join.
        </sh:description>
    <sh:message>
        At least one rml:field property must be specified for a rml:LogicalViewJoin, with a leaf expression field as its value.
        </sh:message>
    <sh:node rdf:resource="http://w3id.org/rml/shapes/LeafExpressionFieldShape"/>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n89aa961460604cb69537555e6da76dadb7">
    <sh:path rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:message>
            Either a rml:AssertedTriplesMap or rml:NonAssertedTriplesMap,
            but not both.
            </sh:message>
    <sh:alternativePath rdf:nodeID="n89aa961460604cb69537555e6da76dadb8"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b21">
    <rdf:first rdf:resource="http://w3id.org/rml/Write"/>
    <rdf:rest rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b22"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na32233bda25c49aaaecebcd6fbdd8f5bb25">
    <sh:description>
        property targetView specifies the LogicalView target of the InclusionAnnotation annotation.
        </sh:description>
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:message>
        Exactly one rml:targetView property must be specified for each rml:InclusionAnnotation.
        </sh:message>
    <sh:path rdf:resource="http://w3id.org/rml/targetView"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb19">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
