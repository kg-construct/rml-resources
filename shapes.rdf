  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLTriplesMapShape">
    <sh:message>
    Triples Map requires exactly one rml:subject or one rml:subjectMap and zero
    or more rml:predicateObjectMaps.
    </sh:message>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/parentTriplesMap"/>
