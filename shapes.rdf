    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:minCount>
    <sh:path rdf:resource="http://w3id.org/rml/baseIRI"/>
    <sh:description>
        Base IRI to use for generating RDF triples or quads.
        </sh:description>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:message>
        rml:baseIRI must be an IRI.
        </sh:message>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb83">
    <sh:path rdf:resource="http://w3id.org/rml/datatypeMap"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/datatypeMap"/>
    <rdfs:comment>
            Specifies the datatype of the object component for the generated 
            RDF triples.
            </rdfs:comment>
    <sh:message>
            rml:datatypeMap must point to a rml:DatatypeMap specifying the
            datatype of the Literal.
            </sh:message>
    <rdfs:label>datatypeMap</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLAssertedAndNonTriplesMapPropertiesShape">
    <sh:targetClass rdf:resource="http://w3id.org/rml/NonAssertedTriplesMap"/>
    <sh:targetClass rdf:resource="http://w3id.org/rml/AssertedTriplesMap"/>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/quotedTriplesMap"/>
    <sh:and rdf:nodeID="n89aa961460604cb69537555e6da76dadb10"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb42">
    <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/predicateMap"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/predicate"/>
    <rdfs:label>predicate/predicateMap</rdfs:label>
    <sh:path rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb43"/>
    <sh:message>
            At least one rml:predicate or rml:predicateMap must be provided.
            </sh:message>
    <rdfs:comment>
            At least one rml:predicate or rml:predicateMap must be provided.
            </rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb70">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
