    <rdf:first rdf:resource="http://w3id.org/rml/functionExecution"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLJoinConditionPropertiesShape">
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:path rdf:resource="http://w3id.org/rml/joinCondition"/>
    <rdfs:label>joinCondition</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/joinCondition"/>
    <rdfs:comment>
    Specifies the join condition for joining a child data source with 
    a parent data source of the foreign key constraint.
    </rdfs:comment>
    <sh:message>
    rml:joinCondition must specify an rml:parent and rml:child.
    </sh:message>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b59">
