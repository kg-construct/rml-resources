  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLLogicalSourceShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:property rdf:nodeID="nb0b4d0f38c824f868fee3f6f22532099b1"/>
    <rdfs:comment>
    A logical source is any source that is mapped to RDF triples.
    </rdfs:comment>
    <sh:targetSubjectsOf rdf:resource="http://w3id.org/rml/source"/>
    <sh:targetClass rdf:resource="http://w3id.org/rml/LogicalSource"/>
    <sh:message>
    RML Logical Source requires one rml:source and requires everyting
    an Abstract Logical Source requires.
    </sh:message>
    <rdfs:label>RML Logical Source</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8659f34fc80740709a8435ee2de7632eb98">
    <rdf:first rdf:resource="http://w3id.org/rml/IRI"/>
