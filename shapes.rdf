    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b28"/>
  </rdf:Description>
