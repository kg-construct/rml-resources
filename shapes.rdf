    <sh:targetClass rdf:resource="http://w3id.org/rml/LanguageMap"/>
    <sh:and rdf:nodeID="n1a96d04a3d334c8faf5aa6e5189f53e4b29"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:targetObjectsOf rdf:resource="http://w3id.org/rml/languageMap"/>
    <rdfs:comment>
    Represents a Language Map.
    </rdfs:comment>
    <rdfs:label>LanguageMap</rdfs:label>
    <sh:message>
    rml:LanguageMap must specify an rml:template, rml:reference, or rml:constant
    with the BCP47 name of the language as string.
    </sh:message>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/rml/shapes/RMLRelativePathSourceShape">
    <rdfs:comment>
    A RML Relative Path Source provides a source with relative paths which is
    not provided by existing vocabularies such as DCAT without a base IRI.
    </rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:label>RML Relative Path Source</rdfs:label>
    <sh:message>
    RML Relative Path Source accepts one rml:root, and one rml:path.
    rml:root is optional and defaults to rml:CurrentWorkingDirectory.
    </sh:message>
    <sh:targetClass rdf:resource="http://w3id.org/rml/RelativePathSource"/>
    <sh:property rdf:nodeID="n7888aee1304b4e40b171952d76614cbab3"/>
    <sh:property rdf:nodeID="n7888aee1304b4e40b171952d76614cbab6"/>
