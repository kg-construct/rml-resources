      {
        "@value": "languageMap"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n            rml:languageMap must point to a rml:LanguageMap specifying the \n            language tag of the string Literal.\n            "
      }
    ],
