      }
    ]
  },
  {
    "@id": "_:n35a43d8e3f4e4494b764f8cc822e7a71b16",
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n        Values of the parameters.\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "rml:inputValueMap"
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n        rml:inputValueMap must be an IRI or Blank node, provided once.\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#BlankNodeOrIRI"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://w3id.org/rml/inputValueMap"
      }
    ]
  },
  {
    "@id": "http://w3id.org/rml/shapes/RMLsubjectShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n    An IRI reference to use as subject for all the RDF triples.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "subject"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n    rml:subject shortcut for rml:SubjectMap must be a IRI or BlankNode.\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#BlankNodeOrIRI"
      }
    ],
    "http://www.w3.org/ns/shacl#targetObjectsOf": [
      {
        "@id": "http://w3id.org/rml/subject"
      }
    ]
  },
  {
    "@id": "http://w3id.org/rml/shapes/RMLAssertedAndNonTriplesMapPropertiesShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#and": [
      {
        "@list": [
          {
            "@id": "_:n45f0c41eeca54b93b46ea7c95c34796eb1"
          },
          {
            "@id": "_:n45f0c41eeca54b93b46ea7c95c34796eb2"
          },
          {
            "@id": "_:n45f0c41eeca54b93b46ea7c95c34796eb7"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#BlankNodeOrIRI"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://w3id.org/rml/NonAssertedTriplesMap"
      },
      {
        "@id": "http://w3id.org/rml/AssertedTriplesMap"
      }
    ],
    "http://www.w3.org/ns/shacl#targetObjectsOf": [
      {
        "@id": "http://w3id.org/rml/quotedTriplesMap"
      }
    ]
  },
  {
    "@id": "_:n45f0c41eeca54b93b46ea7c95c34796eb1",
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n            Exactly one Predicate Object Map must be specified in the\n            Triples Map referenced by rml:quotedTriplesMap.\n            "
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://w3id.org/rml/predicateObjectMap"
      }
    ]
  },
  {
    "@id": "_:n45f0c41eeca54b93b46ea7c95c34796eb2",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n            rml:quotedTriplesMap expects either a rml:AssertedTriplesMap \n            or rml:NonAssertedTriplesMap.\n            "
      }
    ],
    "http://www.w3.org/ns/shacl#or": [
      {
        "@list": [
          {
            "@id": "_:n45f0c41eeca54b93b46ea7c95c34796eb3"
          },
          {
            "@id": "_:n45f0c41eeca54b93b46ea7c95c34796eb4"
          }
        ]
      }
    ]
  },
  {
    "@id": "_:n45f0c41eeca54b93b46ea7c95c34796eb3",
    "http://www.w3.org/ns/shacl#node": [
      {
        "@id": "http://w3id.org/rml/shapes/RMLAssertedTriplesMapShape"
      }
    ]
  },
  {
    "@id": "_:n45f0c41eeca54b93b46ea7c95c34796eb4",
    "http://www.w3.org/ns/shacl#node": [
      {
        "@id": "http://w3id.org/rml/shapes/RMLNonAssertedTriplesMapShape"
      }
    ]
  },
  {
    "@id": "_:n45f0c41eeca54b93b46ea7c95c34796eb7",
    "http://www.w3.org/ns/shacl#alternativePath": [
      {
        "@list": [
          {
            "@id": "http://w3id.org/rml/AssertedTriplesMap"
          },
          {
            "@id": "http://w3id.org/rml/NonAssertedTriplesMap"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n            Either a rml:AssertedTriplesMap or rml:NonAssertedTriplesMap,\n            but not both.\n            "
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type"
      }
    ]
  },
  {
    "@id": "http://w3id.org/rml/lv/shapes",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://www.w3.org/2002/07/owl#imports": [
      {
        "@id": "http://w3id.org/rml/core/shapes"
      }
    ]
  },
  {
    "@id": "http://w3id.org/rml/shapes/RMLTermMapShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n    Represents a Term Map.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "TermMap"
      }
    ],
    "http://www.w3.org/ns/shacl#and": [
      {
        "@list": [
          {
            "@id": "http://w3id.org/rml/shapes/RMLExpressionMapShape"
          },
          {
            "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b128"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n    Term Map is an Expression Map with optionally a term type specified.\n    "
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b128",
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n            An IRI indicating whether a generated term should be an IRI, \n            Blank Node, or a Literal.\n            "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "termType"
      }
    ],
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@id": "http://w3id.org/rml/IRI"
          },
          {
            "@id": "http://w3id.org/rml/UnsafeIRI"
          },
          {
            "@id": "http://w3id.org/rml/URI"
          },
          {
            "@id": "http://w3id.org/rml/UnsafeURI"
          },
          {
            "@id": "http://w3id.org/rml/Literal"
          },
          {
            "@id": "http://w3id.org/rml/BlankNode"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n            rml:termType must be either rml:IRI, rml:UnsafeIRI,\n            rml:URI, rml:UnsafeURI, rml:Literal, or rml:BlankNode for a Term Map.\n            May only be provided once.\n            "
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://w3id.org/rml/termType"
      }
    ],
    "http://www.w3.org/ns/shacl#targetSubjectsOf": [
      {
        "@id": "http://w3id.org/rml/termType"
      }
    ]
  },
  {
    "@id": "http://w3id.org/rml/io/shapes",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://www.w3.org/2002/07/owl#imports": [
      {
        "@id": "http://w3id.org/rml/core/shapes"
      }
    ]
  },
  {
    "@id": "http://w3id.org/rml/shapes/RMLJoinShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n    Represents a Join.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Join"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n    rml:Join must specify exactly one rml:parent/rml:parentMap \n    and rml:child/rml:childMap.\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b23"
      },
      {
        "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b16"
      },
      {
        "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b21"
      },
      {
        "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b24"
      },
      {
        "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b22"
      },
      {
        "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b20"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://w3id.org/rml/Join"
      }
    ],
    "http://www.w3.org/ns/shacl#targetObjectsOf": [
      {
        "@id": "http://w3id.org/rml/joinCondition"
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b23",
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n        Specifies the parent of the object component for joining.\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "parent"
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#Literal"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://w3id.org/rml/parent"
      }
    ],
    "http://www.w3.org/ns/shacl#targetSubjectsOf": [
      {
        "@id": "http://w3id.org/rml/parent"
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b16",
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n        rml:parent/rml:parentMap may only be provided once and \n        not at the same time.\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "parentMap/parent"
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b17"
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b17",
    "http://www.w3.org/ns/shacl#alternativePath": [
      {
        "@list": [
          {
            "@id": "http://w3id.org/rml/parentMap"
          },
          {
            "@id": "http://w3id.org/rml/parent"
          }
        ]
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b21",
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n        Specifies the child of the object component for joining.\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "child"
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#Literal"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://w3id.org/rml/child"
      }
    ],
    "http://www.w3.org/ns/shacl#targetSubjectsOf": [
      {
        "@id": "http://w3id.org/rml/child"
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b24",
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n        rml:child/rml:childMap may only be provided once and \n        not at the same time.\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "childMap/child"
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b25"
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b25",
    "http://www.w3.org/ns/shacl#alternativePath": [
      {
        "@list": [
          {
            "@id": "http://w3id.org/rml/childMap"
          },
          {
            "@id": "http://w3id.org/rml/child"
          }
        ]
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b22",
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n        Specifies the parent of the object component for joining.\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "parentMap"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n        rml:parentMap must point to a rml:ParentMap specifying the \n        parent tag of the string Literal.\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#BlankNodeOrIRI"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://w3id.org/rml/parentMap"
      }
    ],
    "http://www.w3.org/ns/shacl#targetSubjectsOf": [
      {
        "@id": "http://w3id.org/rml/parentMap"
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b20",
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n        Specifies the child of the object component for joining.\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "childMap"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n        rml:childMap must point to a rml:ChildMap specifying the\n        child of the Literal.\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#BlankNodeOrIRI"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://w3id.org/rml/childMap"
      }
    ],
    "http://www.w3.org/ns/shacl#targetSubjectsOf": [
      {
        "@id": "http://w3id.org/rml/childMap"
      }
    ]
  },
  {
    "@id": "http://w3id.org/rml/shapes/RMLDatatypeMapShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n    Represents a Datatype Map.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "DatatypeMap"
      }
    ],
    "http://www.w3.org/ns/shacl#and": [
      {
        "@list": [
          {
            "@id": "http://w3id.org/rml/shapes/RMLExpressionMapShape"
          },
          {
            "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b4"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n    rml:DatatypeMap must specify an rml:template, rml:reference, or rml:constant\n    with the IRI of the datatype.\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://w3id.org/rml/DatatypeMap"
      }
    ],
    "http://www.w3.org/ns/shacl#targetObjectsOf": [
      {
        "@id": "http://w3id.org/rml/datatypeMap"
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b4"
  },
  {
    "@id": "http://w3id.org/rml/shapes/RMLSubjectMapShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n    Represents a Subject Map.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "SubjectMap"
      }
    ],
    "http://www.w3.org/ns/shacl#and": [
      {
        "@list": [
          {
            "@id": "http://w3id.org/rml/shapes/RMLTermMapShape"
          },
          {
            "@id": "http://w3id.org/rml/shapes/RMLGraphMapPropertiesShape"
          },
          {
            "@id": "http://w3id.org/rml/shapes/RMLLogicalTargetPropertiesShape"
          },
          {
            "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b96"
          },
          {
            "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b97"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n    Subject Map must generate a resource representing the subject of\n    an RDF triple.\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://w3id.org/rml/SubjectMap"
      }
    ],
    "http://www.w3.org/ns/shacl#targetObjectsOf": [
      {
        "@id": "http://w3id.org/rml/subjectMap"
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b96",
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n            The subject value generated will be asserted as an instance of this\n            RDFS class.\n            "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "class"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n            rml:class must be an IRI and may be specified multiple times.\n            "
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://w3id.org/rml/class"
      }
    ],
    "http://www.w3.org/ns/shacl#targetSubjectsOf": [
      {
        "@id": "http://w3id.org/rml/class"
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b97",
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@id": "http://w3id.org/rml/IRI"
          },
          {
            "@id": "http://w3id.org/rml/UnsafeIRI"
          },
          {
            "@id": "http://w3id.org/rml/URI"
          },
          {
            "@id": "http://w3id.org/rml/UnsafeURI"
          },
          {
            "@id": "http://w3id.org/rml/BlankNode"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n            rml:termType must be a rml:IRI, rml:UnsafeIRI, rml:URI,\n            rml:UnsafeURI, or rml:BlankNode for a Subject Map.\n            "
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://w3id.org/rml/termType"
      }
    ]
  },
  {
    "@id": "http://w3id.org/rml/shapes/RMLpredicateShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n    Specifies the predicate for the generated triple.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "predicate"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n    rml:predicate must be an IRI.\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
    "http://www.w3.org/ns/shacl#targetObjectsOf": [
      {
        "@id": "http://w3id.org/rml/predicate"
      }
    ]
  },
  {
    "@id": "http://w3id.org/rml/shapes/RMLgraphShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n    An IRI reference for use as the graph name of all triples generated with \n    the Graph Map. \n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "graph"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n    rml:graph must be an IRI or blank node.\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#BlankNodeOrIRI"
      }
    ],
    "http://www.w3.org/ns/shacl#targetObjectsOf": [
      {
        "@id": "http://w3id.org/rml/graph"
      }
    ]
  },
  {
    "@id": "http://w3id.org/rml/shapes/RMLChildMapShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n    Represents a Child Map.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ChildMap"
      }
    ],
    "http://www.w3.org/ns/shacl#and": [
      {
        "@list": [
          {
            "@id": "http://w3id.org/rml/shapes/RMLExpressionMapShape"
          },
          {
            "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b1"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n    rml:ChildMap must specify a literal referencing data in the child data\n    source.\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://www.w3.org/ns/r2rml#ChildMap"
      }
    ],
    "http://www.w3.org/ns/shacl#targetObjectsOf": [
      {
        "@id": "http://www.w3.org/ns/r2rml#childMap"
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b1"
  },
  {
    "@id": "http://w3id.org/rml/shapes/RMLparentShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n    A Literal reference to use as reference to the parent data source.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "parent"
      }
    ],
    "http://www.w3.org/ns/shacl#datatype": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n    rml:parent shortcut for rml:ParentMap must be a Literal.\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#Literal"
      }
    ],
    "http://www.w3.org/ns/shacl#targetObjectsOf": [
      {
        "@id": "http://w3id.org/rml/parent"
      }
    ]
  },
  {
    "@id": "http://w3id.org/rml/shapes/FieldShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n    A field is a construct that gives a name to data derived from an abstract logical source.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Field"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n    Node must have a valid rml:Field description.\n    rml:Field requires a rml:fieldName and may have zero or more rml:field properties.\n    Furthermore, subclass rml:ExpressionField requires what an rml:ExpressionMap requires, subclass rml:IterableField requires what an rml:Iterable requires,.\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:n2d4cf3bfe11241c894a0dbe75d4fd53cb11"
      },
      {
        "@id": "_:n2d4cf3bfe11241c894a0dbe75d4fd53cb10"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://w3id.org/rml/Field"
      }
    ],
    "http://www.w3.org/ns/shacl#targetObjectsOf": [
      {
        "@id": "http://w3id.org/rml/field"
      }
    ]
  },
  {
    "@id": "_:n2d4cf3bfe11241c894a0dbe75d4fd53cb11",
    "http://www.w3.org/ns/shacl#description": [
      {
        "@value": "\n        A child field of the field.\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n        The value of a rml:field property for a rml:Field must be a resource.\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#BlankNodeOrIRI"
      }
    ],
    "http://www.w3.org/ns/shacl#or": [
      {
        "@list": [
          {
            "@id": "_:n2d4cf3bfe11241c894a0dbe75d4fd53cb12"
          },
          {
            "@id": "_:n2d4cf3bfe11241c894a0dbe75d4fd53cb13"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://w3id.org/rml/field"
      }
    ]
  },
  {
    "@id": "_:n2d4cf3bfe11241c894a0dbe75d4fd53cb12",
    "http://www.w3.org/ns/shacl#node": [
      {
        "@id": "http://w3id.org/rml/shapes/ExpressionFieldShape"
      }
    ]
  },
  {
    "@id": "_:n2d4cf3bfe11241c894a0dbe75d4fd53cb13",
    "http://www.w3.org/ns/shacl#node": [
      {
        "@id": "http://w3id.org/rml/shapes/IterableFieldShape"
      }
    ]
  },
  {
    "@id": "_:n2d4cf3bfe11241c894a0dbe75d4fd53cb10",
    "http://www.w3.org/ns/shacl#datatype": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@value": "\n        The name of the field.\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n        Exactly one rml:fieldName property must be specified for a rml:Field, with a string as its value.\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#Literal"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://w3id.org/rml/fieldName"
      }
    ]
  },
  {
    "@id": "http://w3id.org/rml/shapes/RMLIterableShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n    An abstract construct to describe data access and iteration for a data source.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Iterable"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n    Iterable must specify how to generate logical iterations on a data source.\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b74"
      },
      {
        "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b75"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "http://w3id.org/rml/Iterable"
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b74",
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n        The reference formulation (rml:referenceFormulation) defines how to \n        reference to elements of the data of the input source.\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "rml:referenceFormulation"
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n        rml:referenceFormulation must be a blank node or IRI specifying the \n        reference formulation on how to reference elements of a data source,\n        and may be provided at most once.\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#BlankNodeOrIRI"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://w3id.org/rml/referenceFormulation"
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b75",
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n        The logical iterator (rml:iterator) defines the iteration loop used to \n        map the data of the input source. Depends on the reference formulation\n        if an iterator is necessary.  \n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "rml:iterator"
      }
    ],
    "http://www.w3.org/ns/shacl#datatype": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n        rml:iterator must be a Literal specifying the iterator to iterate over \n        the data source, and may be provided at most once.\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#Literal"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://w3id.org/rml/iterator"
      }
    ]
  },
  {
    "@id": "http://w3id.org/rml/shapes/RMLchildShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n    A Literal reference to use as reference to the child data source.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "child"
      }
    ],
    "http://www.w3.org/ns/shacl#datatype": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n    rml:child shortcut for rml:ChildMap must be a Literal.\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#Literal"
      }
    ],
    "http://www.w3.org/ns/shacl#targetObjectsOf": [
      {
        "@id": "http://www.w3.org/ns/r2rml#child"
      }
    ]
  },
  {
    "@id": "http://w3id.org/rml/shapes/RMLStrategyAppendShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n    Strategy to follow when generating RDF triples.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Strategy"
      }
    ],
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@id": "http://w3id.org/rml/append"
          },
          {
            "@id": "http://w3id.org/rml/cartesianProduct"
          }
        ]
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n    Strategy must be either rml:append or rml:cartesianProduct.\n    "
      }
    ],
    "http://www.w3.org/ns/shacl#targetObjectsOf": [
      {
        "@id": "http://w3id.org/rml/strategy"
      }
    ]
  },
  {
    "@id": "http://w3id.org/rml/shapes/RMLGraphMapPropertiesShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b127"
      },
      {
        "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b122"
      },
      {
        "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b126"
      }
    ],
    "http://www.w3.org/ns/shacl#targetSubjectsOf": [
      {
        "@id": "http://w3id.org/rml/graph"
      },
      {
        "@id": "http://w3id.org/rml/graphMap"
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b127",
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n        An IRI reference to use as the named graph of all generated triples.\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "graph"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n        rml:graphMap must be an IRI. \n        "
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://w3id.org/rml/graph"
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b122",
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n        Either an rml:graph or rml:graphMap may be optionally be provided,\n        but not both.\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "graph/graphMap"
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n        Either an rml:graph or rml:graphMap may be optionally be provided,\n        but not both.\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 0
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b123"
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b123",
    "http://www.w3.org/ns/shacl#alternativePath": [
      {
        "@list": [
          {
            "@id": "http://w3id.org/rml/graph"
          },
          {
            "@id": "http://w3id.org/rml/graphMap"
          }
        ]
      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b126",
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n        Specifies a Graph Map. When used with a Subject Map element, all the\n        RDF triples generated will be stored in the specified named graph.\n        Otherwise, the RDF triple generated using the (predicate, object) \n        pair will be stored in the specified named graph.\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "graphMap"
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "\n        rml:graphMap must be either an IRI or blank node. \n        "
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#BlankNodeOrIRI"
