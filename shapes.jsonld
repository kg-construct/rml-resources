      }
    ]
  },
  {
    "@id": "_:n1a96d04a3d334c8faf5aa6e5189f53e4b112",
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n        Either a rml:subject, rml:subjectMap or a rml:quotedTriplesMap is required, not multiple.\n        "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "subjectMap/subject/quotedTriplesMap"
      }
